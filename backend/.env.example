# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000

# Database (Phase 0: node:sqlite; swaps to a Postgres URL later)
DATABASE_FILE=./data/resume_evaluator.sqlite
DB_DIALECT=sqlite

# Auth (Phase 5, hardened in Phase 7). Two callers, two mechanisms: HR logs in and
# carries a JWT, each ATS carries its own API key on the submit door (doc 09).
# JWT_SECRET is REQUIRED when NODE_ENV=production - anything signed with the
# default below could be forged by anyone reading this file.
JWT_SECRET=change-me-in-real-use
# The access token: short, because a JWT cannot be revoked once issued.
JWT_EXPIRES_IN=15m
# The refresh token: how long HR stays signed in. Revocable - logout ends it.
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost factor - higher is slower to hash and slower to crack. 10+ in real use.
BCRYPT_ROUNDS=10
# There is no shared ATS key any more (Phase 7): HR issues one key per ATS with
# POST /api/ats-clients, and revokes it with POST /api/ats-clients/:id/revoke.

# OpenAI (Phase 3 - real runs only; tests mock the LLM)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# ~0: we want exact, repeatable facts, not creativity
LLM_TEMPERATURE=0
# Retries cover network/overload only; a malformed reply fails fast
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=300
LLM_TIMEOUT_MS=30000

# Webhook delivery (Phase 3)
WEBHOOK_MAX_RETRIES=2
WEBHOOK_RETRY_BASE_MS=300
WEBHOOK_TIMEOUT_MS=10000
# The SSRF guard: callbackUrl must be https and must not point at an internal
# address. "true" turns that off so a local receiver (http://127.0.0.1) works -
# for development only, never in production. Off when unset.
WEBHOOK_ALLOW_INSECURE=false

# Limits + storage
MAX_RESUME_SIZE_MB=5
UPLOADS_DIR=./data/uploads
